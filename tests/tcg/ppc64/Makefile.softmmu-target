#
# ppc64 system tests
#
# These run on the PowerMac7,3 board without any firmware: the test image
# itself is passed as -bios and the 970 starts executing it directly.  See
# system/boot.S for what that costs us and what it buys.
#

PPC64_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/ppc64/system
VPATH+=$(PPC64_SYSTEM_SRC)

# These objects provide the basic boot code and helper functions for all tests
CRT_OBJS=boot.o mmufault.o progfault.o

PPC64_TEST_SRCS=$(wildcard $(PPC64_SYSTEM_SRC)/*.c)
PPC64_TESTS = $(patsubst $(PPC64_SYSTEM_SRC)/%.c, %, $(PPC64_TEST_SRCS))

CRT_PATH=$(PPC64_SYSTEM_SRC)
LINK_SCRIPT=$(PPC64_SYSTEM_SRC)/kernel.ld
LDFLAGS=-Wl,-T$(LINK_SCRIPT)
TESTS+=$(PPC64_TESTS) $(MULTIARCH_TESTS)
# ELFv2 keeps boot.S free of function descriptor handling
CFLAGS+=-nostdlib -g -O1 -mabi=elfv2 -mcpu=970
CFLAGS+=$(MINILIB_INC) -I$(PPC64_SYSTEM_SRC)
# the build-id note would land in front of _start, which is the reset vector
LDFLAGS+=-static -nostdlib -Wl,--build-id=none $(CRT_OBJS) $(MINILIB_OBJS) -lgcc

# building head blobs
.PRECIOUS: $(CRT_OBJS)

%.o: $(CRT_PATH)/%.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -x assembler-with-cpp -Wa,--noexecstack -c $< -o $@

# Build and link the tests
%: %.c $(LINK_SCRIPT) $(CRT_OBJS) $(MINILIB_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ $(LDFLAGS)

# A guest on this board can only ever make QEMU exit with status 0 (see
# system/boot.S), so exiting cleanly proves nothing at all: the console
# output is what decides.  A test that hangs prints nothing and still fails,
# by timeout.
run-ppc64-test = $(call run-test, $<, \
	$(QEMU) -monitor none -display none \
		-chardev file$(COMMA)path=$<.out$(COMMA)id=output \
		$(QEMU_OPTS) $<)

$(PPC64_TESTS:%=run-%): run-%: %
	$(run-ppc64-test)
	$(call quiet-command, \
		(grep -q "^PASS: $*" $<.out && ! grep -q "^FAIL" $<.out), \
		"GREP", file $<.out)

# The multiarch tests do not use that convention, so check what they do
# print.  interrupt prints nothing by design, and there the exit status and
# the timeout really are all there is to go on.
run-hello: hello
	$(run-ppc64-test)
	$(call quiet-command, (grep -q "^Hello World" $<.out), "GREP", file $<.out)

run-memory: memory
	$(run-ppc64-test)
	$(call quiet-command, (grep -q "^Test complete: PASSED" $<.out), \
		"GREP", file $<.out)

# the 970 handles unaligned accesses in hardware
memory: CFLAGS+=-DCHECK_UNALIGNED=1

# Running
QEMU_OPTS+=-M powermac7_3 -cpu 970fx -m 512 -serial chardev:output -bios
